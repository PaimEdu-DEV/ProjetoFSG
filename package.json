{
  "name": "programacao-didatica",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run --prefix server start",
    "dev:client": "npm run --prefix client dev",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run --prefix client build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
